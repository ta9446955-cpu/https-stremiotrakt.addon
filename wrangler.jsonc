{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "snakeeyes-trakt",
  "main": "index.js",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "TRAKT_TOKENS",
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
    }
  ]
}
